<Application x:Class="DualSenseWidget.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F2F5FA"/>
    <SolidColorBrush x:Key="Muted" Color="#9CA9BD"/>
    <SolidColorBrush x:Key="ShellBackground" Color="#C2101622"/>
    <SolidColorBrush x:Key="ShellBorder" Color="#88D5EBFF"/>
    <SolidColorBrush x:Key="HeroBackground" Color="#66364D6B"/>
    <SolidColorBrush x:Key="HeroBorder" Color="#55D0E6FF"/>
    <SolidColorBrush x:Key="ControlSurface" Color="#A01B2536"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#66B7D6F5"/>
    <SolidColorBrush x:Key="ButtonSurface" Color="#A028364D"/>
    <SolidColorBrush x:Key="PlayerSurface" Color="#A029344A"/>
    <SolidColorBrush x:Key="TrackSurface" Color="#A0405271"/>
    <SolidColorBrush x:Key="RuleSurface" Color="#4D8BA5C9"/>
    <SolidColorBrush x:Key="PopupSurface" Color="#F71B2536"/>
    <SolidColorBrush x:Key="GlassHighlight" Color="Transparent"/>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E4ECF7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="10,7"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#344862"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2B3F59"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E4ECF7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ControlSurface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="7"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,7,26,7" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBlock Text="⌄" Foreground="#AABAD0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="7" MinWidth="{TemplateBinding ActualWidth}" Padding="3" Margin="0,3,0,0">
              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#40516C" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DFE7F4"/><Setter Property="Background" Value="{DynamicResource ButtonSurface}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/><Setter TargetName="Surface" Property="BorderBrush" Value="#7EDBFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C6D1E1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="TrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="255"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="1"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Foreground" Value="#7ABFFF"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Height="24" Background="Transparent">
          <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource TrackButton}" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="13" Height="13"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#E9F5FF" Stroke="#669BCB" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource TrackButton}" Command="Slider.IncreaseLarge" Background="{DynamicResource TrackSurface}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PlayerLight" TargetType="ToggleButton">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#A9B6CC"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Led" CornerRadius="6" Background="{DynamicResource PlayerSurface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Led" Property="Background" Value="#E9F6FF"/><Setter Property="Foreground" Value="#142238"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Led" Property="BorderBrush" Value="#4DAAFF"/><Setter TargetName="Led" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
