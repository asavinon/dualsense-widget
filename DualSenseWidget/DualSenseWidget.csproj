<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ControllerLightsAndBattery</AssemblyName>
    <Version>1.5.2</Version>
    <Product>Controller Lights and Battery</Product>
    <Title>Controller Lights and Battery</Title>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Widget.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Resource Include="Widget.ico" /></ItemGroup>
</Project>
